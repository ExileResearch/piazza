{
  "name": "server-core",
  "version": "0.0.1",
  "description": "Piazza NestJS API and persistence foundation",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/*.mjs\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "npm test -- --watch",
    "test:cov": "npm test -- --coverage",
    "test:debug": "node --experimental-vm-modules --inspect-brk node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "npm test -- --config test/jest-e2e.json",
    "typecheck": "tsc --noEmit",
    "lint:fix": "npm run lint -- --fix",
    "test:unit": "npm test",
    "test:integration": "npm test -- --config test/jest-integration.json",
    "migration:generate": "npm run build && node node_modules/typeorm/cli.js migration:generate -d dist/database/data-source.js",
    "migration:run": "npm run build && node node_modules/typeorm/cli.js migration:run -d dist/database/data-source.js",
    "migration:revert": "npm run build && node node_modules/typeorm/cli.js migration:revert -d dist/database/data-source.js",
    "migration:show": "npm run build && node node_modules/typeorm/cli.js migration:show -d dist/database/data-source.js",
    "verify": "node scripts/verify.mjs",
    "test:database": "node scripts/test-database.mjs"
  },
  "dependencies": {
    "@getbrevo/brevo": "6.2.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "12.0.2",
    "@piazza/contracts": "file:../../packages/contracts",
    "axios": "1.20.0",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.9",
    "handlebars": "4.7.10",
    "helmet": "8.3.0",
    "multer": "2.5.0",
    "node-appwrite": "31.0.0",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2",
    "uuid": "14.0.3",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.8",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.4.1"
    },
    "multer": "$multer"
  }
}
