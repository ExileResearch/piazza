# Copy to apps/server-core/.env; process-injected values win. Never commit secrets.
# Tests ignore the local .env. No login, admin seed or provider mutations are implemented yet.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:4200
SWAGGER_ENABLED=false
# Set only to the exact number of trusted reverse-proxy hops; default trusts none.
TRUST_PROXY_HOPS=0
REQUEST_BODY_LIMIT_BYTES=262144
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=120
# Reserved auth profile, enforced when auth routes are implemented.
RATE_LIMIT_AUTH_TTL_MS=60000
RATE_LIMIT_AUTH_LIMIT=10
DEPENDENCY_TIMEOUT_MS=2000
APP_WEB_URL=http://localhost:4200

# Developer administrator (future idempotent seed; never a public signup role).
ADMIN_EMAIL=
# Legacy EMAIL/PROD/WEB_CLIENT_URL aliases remain accepted. Conflicting aliases fail validation.
# Cookie settings from the starter are unused: Piazza uses no cookie sessions.

# PostgreSQL: use DATABASE_URL OR the DB_* fields below. URL takes precedence.
# URL query/fragment options are rejected; use the explicit SSL settings.
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=piazza
DB_PASSWORD=
DB_NAME=piazza
DB_POOL_MAX=10
# Prefer explicit reviewed migrations; automatic migration application is opt-in.
DB_MIGRATIONS_RUN=false
# Always disabled by the application. true is ignored with a warning in dev/test, rejected in production.
DB_SYNCHRONIZE=false
# Production requires verify-full. Supply a PEM CA for a private CA; system trust is otherwise used.
DB_SSL_MODE=disable
DB_SSL_CA=

# Future auth use cases require independently generated secrets; empty is accepted by this foundation.
# JWT_SECRET / OTP_HASH_KEY: >=32 characters, no example/change-me placeholders.
# TOTP_ENCRYPTION_KEY: 64 hexadecimal characters (32 random bytes).
JWT_SECRET=
OTP_HASH_KEY=
TOTP_ENCRYPTION_KEY=
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_ACCESS_TTL_SECONDS=600
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_STEP_UP_TTL_SECONDS=300
AUTH_RUNTIME_CREDENTIAL_TTL_SECONDS=86400
EVENT_CURSOR_TTL_SECONDS=300
EVENT_RETENTION_SECONDS=86400
IDEMPOTENCY_TTL_SECONDS=86400

# Brevo transactional delivery: validated when supplied, not yet used to send mail.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Appwrite: all four settings are required for readiness to report storage available.
# Endpoint includes /v1. Server key must be able to read the selected bucket's metadata.
# No files are uploaded or released by this foundation. Production endpoint must be HTTPS.
APPWRITE_ENDPOINT=
APPWRITE_API_KEY=
APPWRITE_PROJECT_ID=
APPWRITE_BUCKET_ID=

# Reserved user-supplied LLM settings: retained, ignored by this foundation.
# No model calls, automatic moderation or BICA integration is activated.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=
