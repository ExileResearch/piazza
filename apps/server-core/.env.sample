# Copy this template only when creating a new .env. Merge individual settings into an existing file.
# Keep each setting once in .env; keep real credentials there, never in this sample.
# Process-injected values win. Tests ignore the local .env.

# System configuration
PORT=3000
CORS_ORIGINS=http://localhost:4200
PROD=false
SWAGGER_ENABLED=false
APP_WEB_URL=http://localhost:4200
# Existing cookie settings are unused; Piazza has no cookie sessions.
# REFRESH_TOKEN_COOKIE_NAME, REFRESH_TOKEN_COOKIE_SAMESITE, COOKIE_DOMAIN

# Seeded admin account (future idempotent developer seed; not a public signup role)
EMAIL=

# Database configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=piazza
DB_PASSWORD=
DB_NAME=piazza
DB_MIGRATIONS_RUN=false
# Synchronization is always disabled; true is ignored in dev/test and rejected in production.
DB_SYNCHRONIZE=false
# Optional database overrides; omit to use the code defaults shown.
# DATABASE_URL is an alternative to the DB_* connection fields, not an additional requirement.
# If supplied, it takes precedence. URL query/fragment options are rejected.
# DATABASE_URL=
# DB_POOL_MAX=10
# Production requires verify-full; otherwise the default is disable.
# DB_SSL_MODE=verify-full
# DB_SSL_CA=

# Authentication
# No login or mail delivery is implemented yet. Supplied secrets are validated.
# JWT_SECRET / OTP_HASH_KEY: >=32 characters, no example/change-me placeholders.
# TOTP_ENCRYPTION_KEY: 64 hexadecimal characters (32 random bytes).
JWT_SECRET=
# Auth-specific limit: reserved for authentication routes, separate from general API limits below.
RATE_LIMIT_AUTH_TTL_MS=60000
RATE_LIMIT_AUTH_LIMIT=10
OTP_HASH_KEY=
TOTP_ENCRYPTION_KEY=
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_ACCESS_TTL_SECONDS=600
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_STEP_UP_TTL_SECONDS=300
AUTH_RUNTIME_CREDENTIAL_TTL_SECONDS=86400
EVENT_CURSOR_TTL_SECONDS=300
EVENT_RETENTION_SECONDS=86400
IDEMPOTENCY_TTL_SECONDS=86400

# Optional HTTP/runtime overrides: these are new, distinct controls, not replacements for existing settings.
# Omit them to use the code defaults shown. No additional entries are needed just to repeat defaults.
# HOST=127.0.0.1
# Set only to the exact number of trusted reverse-proxy hops; zero trusts none.
# TRUST_PROXY_HOPS=0
# Maximum JSON body size, in bytes.
# REQUEST_BODY_LIMIT_BYTES=262144
# General API request window/count, independent of RATE_LIMIT_AUTH_*.
# RATE_LIMIT_TTL_MS=60000
# RATE_LIMIT_LIMIT=120
# Database/storage probe timeout, in milliseconds; distinct from LLM_TIMEOUT_MS.
# DEPENDENCY_TIMEOUT_MS=2000

# Brevo Configuration (validated if supplied; no email is sent by this foundation)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Appwrite Configuration
# All four settings are required for storage readiness. Endpoint includes /v1; HTTPS in production.
# The server key needs bucket metadata access. No upload/scan/release functionality is active yet.
APPWRITE_ENDPOINT=
APPWRITE_API_KEY=
APPWRITE_PROJECT_ID=
APPWRITE_BUCKET_ID=

# LLM variables (retained, currently unused; no model calls or BICA integration)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=
